---
import Layout from "../layouts/Layout.astro";
import FactCard from "../components/FactCard.jsx";
import facts from "../data/facts.json";
---

<Layout
  title="The MCU Archives & Classified Lore — Road to Doomsday"
  description="Explore verified records, behind-the-scenes trivia, comic book roots, and hidden connections across the Marvel Cinematic Universe."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-16">
    <!-- ── Archive Header ── -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.06] border border-white/10 text-white/90">
        <span class="w-1.5 h-1.5 rounded-full bg-crimson animate-pulse"></span>
        <span class="text-[11px] font-mono font-bold uppercase tracking-[0.25em]">
          CLASSIFIED HISTORICAL INTEL
        </span>
      </div>

      <h1 class="font-display text-4xl sm:text-6xl font-extrabold text-white tracking-wide title-glow">
        THE MCU <span class="text-crimson-bright">ARCHIVES</span>
      </h1>

      <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
        A curated reference library detailing production breakthroughs, comic book inspirations, Stan Lee legacy cameos, and hidden easter eggs.
      </p>
    </div>

    <!-- ── Quick Statistics Dossier ── -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto">
      <div class="p-4 rounded-2xl bg-[#0c0e18] border border-white/[0.08] text-center">
        <span class="text-[10px] font-mono uppercase tracking-wider text-muted-dark block">TOTAL DOSSIERS</span>
        <span class="font-mono text-2xl font-bold text-white mt-1 block">{facts.length}</span>
      </div>
      <div class="p-4 rounded-2xl bg-[#0c0e18] border border-white/[0.08] text-center">
        <span class="text-[10px] font-mono uppercase tracking-wider text-muted-dark block">CANON HISTORY</span>
        <span class="font-mono text-2xl font-bold text-amber-400 mt-1 block">
          {facts.filter((f) => f.type === "history").length}
        </span>
      </div>
      <div class="p-4 rounded-2xl bg-[#0c0e18] border border-white/[0.08] text-center">
        <span class="text-[10px] font-mono uppercase tracking-wider text-muted-dark block">BEHIND THE SCENES</span>
        <span class="font-mono text-2xl font-bold text-sky-400 mt-1 block">
          {facts.filter((f) => f.type === "production").length}
        </span>
      </div>
      <div class="p-4 rounded-2xl bg-[#0c0e18] border border-white/[0.08] text-center">
        <span class="text-[10px] font-mono uppercase tracking-wider text-muted-dark block">EASTER EGGS</span>
        <span class="font-mono text-2xl font-bold text-emerald-400 mt-1 block">
          {facts.filter((f) => f.type === "easter-egg").length}
        </span>
      </div>
    </div>

    <!-- ── Archival Fact Cards Grid ── -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {facts.map((fact) => (
        <FactCard fact={fact} client:load />
      ))}
    </div>

    <!-- ── Quote Banner ── -->
    <div class="p-8 sm:p-10 rounded-3xl border border-white/[0.08] bg-[#0a0d16] text-center max-w-3xl mx-auto space-y-3">
      <span class="text-3xl">🛡️</span>
      <h3 class="font-display text-xl font-bold text-white">
        "Part of the journey is the end."
      </h3>
      <p class="text-xs text-muted max-w-md mx-auto">
        Every fact, cameo, and origin story is a thread in the grand tapestry weaving toward Avengers: Doomsday.
      </p>
    </div>
  </div>
</Layout>