---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import CountdownTimer from "../components/CountdownTimer.jsx";
import SectionVideo from "../components/SectionVideo.jsx";
import CharacterSpotlight from "../components/CharacterSpotlight.jsx";
import JourneyProgress from "../components/JourneyProgress.jsx";
import App from "../components/App.jsx";
import { movies } from "../data/movies.json";

const HERO_PLAYLIST = ["/bg/doomsday.mp4"];
---
<Layout>
  <SiteNav />

  <!-- ═══ HERO SECTION ═══ -->
  <section class="relative min-h-[70vh] sm:min-h-[85vh] flex items-center overflow-hidden">
    <!-- Enhanced Cinematic Background Layers -->
    <div class="pointer-events-none absolute inset-0 z-[0]">
      <!-- Base cosmic layer -->
      <div class="absolute inset-0 bg-[url('/public/bg/cosmic-base.jpg')] bg-cover bg-center opacity-[0.15]" />

      <!-- Mid-layer nebulae -->
      <div class="absolute inset-0 bg-[url('/public/bg/nebulae.jpg')] bg-cover bg-center opacity-[0.1] animate-[slowFloat_20s_ease-in-out_infinite]" />

      <!-- Dynamic color grading overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-[rgba(15,15,18,0.7)] via-[rgba(25,25,35,0.8)] to-[rgba(15,15,18,0.9)]" />

      <!-- Animated light leaks -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(220,38,38,0.15)_0%,transparent_40%),radial-gradient(circle_at_bottom_right,_rgba(99,102,241,0.1)_0%,transparent_40%)] bg-[size:400%_400%] animate-[lightLeak_12s_ease-in-out_infinite]" />

      <!-- Subtle film grain -->
      <div class="absolute inset-0 bg-[url('/public/bg/film-grain.png')] bg-repeat opacity-[0.02]" />

      <!-- Floating particles -->
      <div class="absolute inset-0 bg-[url('/public/bg/floating-particles.png')] bg-repeat opacity-[0.01] animate-[floatParticles_8s_linear_infinite]" />
    </div>

    <!-- Enhanced Hero Content -->
    <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 py-24">
      <div class="text-center">
        <!-- Enhanced Section Label -->
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="text-[10px] font-semibold uppercase tracking-[0.4em] text-muted-dark/60">
            Way to Doomsday
          </span>
          <div class="w-3 h-0.5 bg-gradient-to-r from-cosmic via-crimson to-warm-cream/50" />
        </div>

        <!-- Main Title with Enhanced Cinematic Treatment -->
        <h1 class="font-display text-6xl sm:text-7xl tracking-[0] leading-[1.05] mb-6 relative inline-block">
          <span class="relative z-10 bg-gradient-to-r from-cosmic via-crimson to-warm-cream bg-clip-text text-transparent">
            Your journey through the
          </span>
          <span class="block relative z-10">
            <span class="font-display text-7xl sm:text-8xl tracking-[-0.02em] leading-[0.9] bg-gradient-to-r from-cosmic via-crimson to-warm-cream bg-clip-text text-transparent drop-shadow-[0_0_30px_rgba(99,102,241,0.5)]">
              Marvel Multiverse
            </span>
          </span>
        </h1>

        <!-- Enhanced Description -->
        <p class="text-muted max-w-3xl mx-auto text-base leading-relaxed mb-8">
          Experience every Marvel Cinematic Universe story in chronological order,
          building toward the ultimate confrontation in Avengers: Doomsday.
        </p>

        <!-- Enhanced Countdown Container -->
        <div class="relative inline-block mb-10">
          {/* Countdown Label */}
          <div class="flex items-center gap-3 mb-4">
            <span class="text-[11px] uppercase tracking-[0.25em] text-muted-dark font-medium">
              Countdown to Doomsday
            </span>
            <div class="w-4 h-0.5 bg-gradient-to-r from-cosmic via-crimson to-warm-cream/30" />
          </div>

          {/* Countdown Display */}
          <div class="relative">
            {/* Countdown Background */}
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-[rgba(15,15,18,0.6)] via-[rgba(25,25,35,0.7)] to-[rgba(15,15,18,0.8)] border border-white/10 backdrop-blur-xl" />

            {/* Countdown Content */}
            <div class="relative z-10 flex items-center gap-6 px-8 py-4 rounded-2xl border border-white/10 backdrop-blur-xl">
              <span class="text-[3rem] sm:text-[4.5rem] font-mono leading-none text-white tracking-tighter relative">
                <CountdownTimer client:load className="text-inherit" />
              </span>
              {/* Countdown Sub-label */}
              <div class="flex flex-col items-start">
                <span class="text-[10px] uppercase tracking-wider text-muted-dark/60">
                  DAYS
                </span>
                <span class="text-[10px] uppercase tracking-wider text-muted-dark/60">
                  HOURS
                </span>
                <span class="text-[10px] uppercase tracking-wider text-muted-dark/60">
                  MINUTES
                </span>
              </div>
            </div>

            {/* Countdown Glow */}
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-cosmic/20 via-crimson/20 to-warm-cream/20 blur-[8px] -z-10 opacity-0 hover:opacity-60 transition-opacity duration-300" />
          </div>
        </div>

        {/* Enhanced CTA Buttons */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <a href="#timeline" class="btn-primary btn-neon px-8 py-3 text-base sm:text-lg w-full sm:w-auto relative overflow-hidden">
            Begin Your Journey
            <span class="absolute inset-0 bg-gradient-to-r from-cosmic via-crimson to-warm-cream/20 blur-[4px] -z-10 opacity-0 hover:opacity-60 transition-opacity duration-300"></span>
          </a>
          <a href="/multiverse" class="btn-secondary btn-outline px-8 py-3 text-base sm:text-lg w-full sm:w-auto relative overflow-hidden">
            Explore the Multiverse
            <span class="absolute inset-0 bg-gradient-to-r from-cosmic via-crimson to-warm-cream/20 blur-[4px] -z-10 opacity-0 hover:opacity-60 transition-opacity duration-300"></span>
          </a>
        </div>

        {/* Fun Tagline with Motion */}
        <p class="text-xs text-muted-dark mt-8 tracking-wider uppercase font-mono relative">
          "One timeline. Zero chill."
          <span class="absolute inset-0 bg-gradient-to-r from-cosmic via-crimson to-warm-cream/10 blur-[2px] -z-10" />
        </p>
      </div>
    </div>

    {/* Enhanced Bottom Fade with Cosmic Touch */}
    <div class="absolute bottom-0 left-0 right-0 h-[250px] sm:h-[300px] bg-gradient-to-t from-[rgba(8,8,10,0.9)] to-[rgba(8,8,10,0)] z-[2]">
      <div class="absolute inset-0 bg-gradient-to-b from-cosmic/5 to-transparent" />
      <div class="absolute inset-0 bg-[url('/public/bg/bottom-particles.png')] bg-repeat opacity-[0.02]" />
    </div>
  </section>

  {/* ═══ JOURNEY PROGRESS ═══ */}
  <JourneyProgress client:load />

  {/* ═══ CHARACTER SPOTLIGHT ═══ */}
  <section class="relative pt-16 pb-20 border-t border-white/[0.06]">
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <CharacterSpotlight client:load />
    </div>
  </section>

  {/* ═══ TIMELINE INTRODUCTION ═══ */}
  <section class="relative pt-20 pb-24 border-t border-white/[0.06]">
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-display text-2xl sm:text-3xl tracking-wide text-center mb-6">
        TIMELINE
      </h2>
      <p class="text-muted max-w-xl mx-auto text-center">
        Experience the MCU in story order, tracking your progress toward the ultimate confrontation.
      </p>
    </div>
  </section>

  {/* ═══ MAIN TIMELINE ═══ */}
  <section id="timeline">
    <App client:visible />
  </section>

  {/* Footer will be added by Layout */}
</Layout>