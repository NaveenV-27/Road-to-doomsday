---
import Layout from "../layouts/Layout.astro";
import SectionVideo from "../components/SectionVideo.jsx";
import CountdownTimer from "../components/CountdownTimer.jsx";
import JourneyProgress from "../components/JourneyProgress.jsx";
import CharacterSpotlight from "../components/CharacterSpotlight.jsx";
import movies from "../data/movies.json";
import facts from "../data/facts.json";
import universes from "../data/universes.json";

// Highlighted pivotal saga moments for the timeline preview
const PIVOTAL_MOMENTS = [
  { id: "captain-america-first-avenger", label: "The First Super Soldier", phase: 1 },
  { id: "iron-man", label: "Birth of the MCU", phase: 1 },
  { id: "avengers", label: "Earth's Mightiest Heroes", phase: 1 },
  { id: "captain-america-civil-war", label: "Heroes Divided", phase: 3 },
  { id: "avengers-infinity-war", label: "The Snap", phase: 3 },
  { id: "avengers-endgame", label: "Whatever It Takes", phase: 3 },
  { id: "loki", label: "Sacred Timeline Fractures", phase: 4 },
  { id: "spider-man-no-way-home", label: "Multiverse Collides", phase: 4 },
  { id: "deadpool-and-wolverine", label: "Timeline Anchor", phase: 5 },
  { id: "avengers-doomsday", label: "The Convergence", phase: 6 },
];

const momentMovies = PIVOTAL_MOMENTS.map((m) => {
  const found = movies.find((item) => item.id === m.id);
  return { ...found, label: m.label, phaseNumber: m.phase };
}).filter((item) => item && item.id);
---

<Layout
  title="Road to Doomsday — The Definitive MCU Timeline & Watch Companion"
  description="Experience every Marvel Cinematic Universe story in story order leading to Avengers: Doomsday. Track your progress, explore characters, and navigate the multiverse."
>
  <!-- ═══ 1. CINEMATIC HERO SECTION ═══ -->
  <section class="relative min-h-[90vh] sm:min-h-[95vh] flex items-center justify-center overflow-hidden">
    <!-- Video Background -->
    <SectionVideo client:load playlist={["/bg/doomsday.mp4"]} overlay="soft" />

    <!-- Pure CSS Atmospheric & Vignette Layers -->
    <div class="pointer-events-none absolute inset-0 z-[1] hero-vignette" />
    <div class="pointer-events-none absolute inset-0 z-[1] cosmic-radial-bg opacity-70" />
    <div class="pointer-events-none absolute inset-0 z-[1] cosmic-stars-grid opacity-30" />

    <!-- Hero Content -->
    <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.06] border border-white/10 backdrop-blur-md mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-crimson animate-pulse"></span>
        <span class="text-[11px] font-mono font-bold uppercase tracking-[0.25em] text-white/90">
          THE ULTIMATE MARVEL COMPANION
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl tracking-[0.04em] font-extrabold text-white leading-[1.05] mb-6 title-glow uppercase">
        Road to <span class="text-crimson-bright block sm:inline">Doomsday</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-text-secondary text-base sm:text-lg lg:text-xl max-w-2xl mx-auto font-normal leading-relaxed mb-10">
        Experience every MCU movie and series in story order. Track your complete journey across 6 Phases toward the ultimate collision in <strong class="text-white">Avengers: Doomsday</strong>.
      </p>

      <!-- Prominent Countdown to Release -->
      <div class="flex flex-col items-center justify-center mb-10">
        <span class="text-[10px] sm:text-[11px] font-mono font-semibold uppercase tracking-[0.3em] text-muted-dark mb-3">
          COUNTDOWN TO THEATRICAL ARRIVAL
        </span>
        <CountdownTimer client:load />
      </div>

      <!-- Call to Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 max-w-md mx-auto">
        <a href="/timeline" class="btn-primary w-full sm:w-auto">
          Begin Your Journey
        </a>
        <a href="/multiverse" class="btn-secondary w-full sm:w-auto">
          Explore Multiverse
        </a>
      </div>

      <!-- Subtle Fan Tagline -->
      <p class="text-xs font-mono uppercase tracking-[0.2em] text-muted-dark/80 mt-10">
        "One sacred timeline. Infinite possibilities."
      </p>
    </div>

    <!-- Seamless bottom gradient blend -->
    <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-bg via-bg/80 to-transparent z-[2]" />
  </section>

  <!-- ═══ 2. JOURNEY PROGRESS / MISSION TRACKER ═══ -->
  <JourneyProgress client:load />

  <!-- ═══ 3. TIMELINE SAGA PREVIEW ═══ -->
  <section class="relative py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/[0.06]">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-crimson-bright">
            THE SAGA CHRONOLOGY
          </span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl text-white tracking-wide">
          KEY CONVERGENCE <span class="text-crimson-bright">POINTS</span>
        </h2>
        <p class="text-muted text-sm max-w-xl mt-2 leading-relaxed">
          From Steve Rogers in 1943 to the multiversal incursion of Doomsday. Explore milestone chapters before diving into the interactive timeline.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/timeline" class="btn-secondary text-xs py-2.5 px-5">
          Open Complete Timeline &rarr;
        </a>
      </div>
    </div>

    <!-- Horizontal Milestone Carousel / Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
      {momentMovies.map((movie) => (
        <a
          href={`/movie/${movie.id}`}
          class="group block relative rounded-2xl overflow-hidden border border-white/[0.08] bg-[#0c0e17] transition-all duration-300 hover:border-white/20 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-crimson/10"
        >
          <!-- Poster Container (natural 2:3 aspect ratio) -->
          <div class="relative aspect-[2/3] w-full overflow-hidden bg-black/60">
            <img
              src={movie.poster}
              alt={movie.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0c0e17] via-transparent to-transparent opacity-80" />
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-black/70 backdrop-blur-md text-white border border-white/10">
              P{movie.phaseNumber}
            </span>
          </div>

          <!-- Metadata -->
          <div class="p-3.5 space-y-1.5">
            <span class="text-[10px] font-mono text-crimson-bright uppercase tracking-wider block truncate">
              {movie.label}
            </span>
            <h3 class="font-display text-xs sm:text-sm font-bold text-white group-hover:text-text-secondary transition-colors line-clamp-1">
              {movie.title}
            </h3>
            <div class="flex items-center justify-between text-[11px] font-mono text-muted-dark pt-1">
              <span>{movie.chronologicalYear}</span>
              <span class="capitalize">{movie.type}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ 4. CHARACTER SPOTLIGHT SECTION ═══ -->
  <section class="relative py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/[0.06]">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-crimson-bright block mb-2">
        HEROES &amp; TITANS
      </span>
      <h2 class="font-display text-3xl sm:text-4xl text-white tracking-wide">
        CHARACTERS SHAPING <span class="text-crimson-bright">THE SAGA</span>
      </h2>
      <p class="text-muted text-sm mt-3">
        Follow individual character arcs through every battle, sacrifice, and evolution leading up to Avengers: Doomsday.
      </p>
    </div>

    <CharacterSpotlight client:load />

    <div class="text-center mt-10">
      <a href="/characters" class="btn-secondary text-xs">
        Browse Complete Character Roster &rarr;
      </a>
    </div>
  </section>

  <!-- ═══ 5. MULTIVERSE EXPEDITION PORTAL ═══ -->
  <section class="relative py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/[0.06]">
    <div class="relative rounded-3xl overflow-hidden border border-white/[0.08] bg-gradient-to-b from-[#0f1220]/90 to-[#070910] p-8 sm:p-12 lg:p-16">
      <div class="cosmic-radial-bg absolute inset-0 opacity-60 pointer-events-none" />

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-bright animate-ping"></span>
            <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-accent-bright">
              MULTIVERSAL HORIZON
            </span>
          </div>

          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white font-extrabold tracking-wide leading-tight">
            BEYOND THE <span class="text-accent-bright">SACRED TIMELINE</span>
          </h2>

          <p class="text-text-secondary text-sm sm:text-base leading-relaxed max-w-xl">
            Earth-616 is no longer alone. From Sam Raimi's Spider-Man realities and Fox's mutant universe to the branching timelines of What If...?, discover where every realm collides before Secret Wars.
          </p>

          <div class="flex flex-wrap gap-2.5 pt-2">
            {universes.slice(0, 5).map((u) => (
              <span class="px-3 py-1 rounded-full text-xs font-mono bg-white/[0.05] border border-white/[0.08] text-white/90">
                {u.name}
              </span>
            ))}
          </div>

          <div class="pt-4">
            <a href="/multiverse" class="btn-primary text-xs py-3 px-6">
              Enter Multiverse Explorer &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 grid grid-cols-2 gap-3.5">
          {universes.slice(0, 4).map((u) => (
            <div class="p-4 rounded-xl border border-white/[0.06] bg-black/40 backdrop-blur-md space-y-2">
              <span class="text-[10px] font-mono uppercase text-accent-bright tracking-wider block">
                {u.label} Reality
              </span>
              <h4 class="font-display text-sm font-bold text-white line-clamp-1">
                {u.name}
              </h4>
              <p class="text-[11px] text-muted line-clamp-2 leading-snug">
                {u.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 6. ARCHIVE & MCU TRIVIA DOSSIER PREVIEW ═══ -->
  <section class="relative py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/[0.06]">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-crimson-bright block mb-2">
          CLASSIFIED INTEL
        </span>
        <h2 class="font-display text-3xl sm:text-4xl text-white tracking-wide">
          MCU ARCHIVE &amp; <span class="text-crimson-bright">LORE</span>
        </h2>
        <p class="text-muted text-sm max-w-xl mt-2 leading-relaxed">
          Behind-the-scenes production secrets, comic origins, and post-credit breakdowns connecting the entire franchise.
        </p>
      </div>

      <a href="/archive" class="btn-secondary text-xs py-2.5 px-5">
        Browse All Dossiers &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {facts.slice(0, 3).map((f) => (
        <div class="cinematic-card p-6 flex flex-col justify-between">
          <div>
            <div className="flex items-center justify-between gap-2 mb-3">
              <span class="text-[10px] font-mono uppercase tracking-widest text-crimson-bright">
                FILE #{f.id}
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-white/[0.05] text-muted">
                {f.type}
              </span>
            </div>
            <h3 class="font-display text-lg font-bold text-white mb-2">
              {f.title}
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              {f.body}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.05] flex items-center justify-between text-[11px] font-mono text-muted-dark">
            <span>Verified Record</span>
            <a href="/archive" class="text-text-secondary hover:text-white transition-colors">
              Read file &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ 7. FINAL DOOMSDAY CALL-TO-ACTION ═══ -->
  <section class="relative py-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center border-t border-white/[0.06]">
    <div class="relative z-10 space-y-6">
      <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-crimson-bright font-bold">
        DECEMBER 2026 PREMIERE
      </span>
      <h2 class="font-display text-4xl sm:text-6xl text-white font-extrabold uppercase tracking-wide leading-tight">
        PREPARE FOR <span class="text-crimson-bright">DOOMSDAY</span>
      </h2>
      <p class="text-muted text-base max-w-xl mx-auto leading-relaxed">
        54 movies and series. Over a decade of cinematic storytelling. Start from Captain America or Iron Man today and watch along.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/timeline" class="btn-primary py-3.5 px-8 text-sm">
          Start Watching Now
        </a>
        <a href="/journey" class="btn-secondary py-3.5 px-8 text-sm">
          View Milestone Journey
        </a>
      </div>
    </div>
  </section>
</Layout>