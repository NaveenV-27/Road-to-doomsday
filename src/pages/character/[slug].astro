---
import Layout from "../../layouts/Layout.astro";
import CharacterTimeline from "../../components/CharacterTimeline.jsx";
import CHARACTERS from "../../data/characters.json";
import movies from "../../data/movies.json";

export function getStaticPaths() {
  return CHARACTERS.map((character) => ({
    params: { slug: character.slug },
    props: { character },
  }));
}

const { character } = Astro.props;

// Other characters in roster for cross-linking
const otherCharacters = CHARACTERS.filter((c) => c.slug !== character.slug);
---

<Layout
  title={`${character.name} MCU Timeline & Arc — Road to Doomsday`}
  description={`Follow ${character.name}'s complete Marvel Cinematic Universe arc from origin to Doomsday.`}
  ogImage={character.poster}
>
  <!-- ── Character Hero Header with Blurred Atmospheric Backdrop ── -->
  <section class="relative min-h-[55vh] flex items-end overflow-hidden border-b border-white/[0.08]">
    <!-- Blurred Backdrop from Character Poster -->
    <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden">
      <img
        src={character.poster}
        alt=""
        aria-hidden="true"
        class="w-full h-full object-cover scale-110 blur-3xl opacity-20 brightness-50 contrast-125"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/80 to-transparent" />
      <div class="absolute inset-0 bg-gradient-to-r from-bg via-transparent to-bg/90" />
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12">
      <!-- Breadcrumb -->
      <a
        href="/characters"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-muted hover:text-white transition-colors uppercase tracking-wider mb-6"
      >
        <span>&larr; Character Roster</span>
      </a>

      <div class="flex flex-col sm:flex-row sm:items-end gap-6 sm:gap-10">
        <!-- Foreground Portrait (Natural aspect ratio) -->
        <div class="w-32 sm:w-44 aspect-[3/4] shrink-0 rounded-2xl overflow-hidden border border-white/15 bg-black/70 shadow-2xl">
          <img
            src={character.poster}
            alt={character.name}
            class="w-full h-full object-cover object-top"
          />
        </div>

        <div class="space-y-3">
          <div class="inline-flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-crimson shadow-[0_0_8px_rgba(220,38,38,0.8)]"></span>
            <span class="text-xs font-mono font-bold uppercase tracking-[0.2em] text-crimson-bright">
              {character.tagline}
            </span>
          </div>

          <h1 class="font-display text-4xl sm:text-6xl font-extrabold text-white tracking-wide leading-none title-glow">
            {character.name}
          </h1>

          <p class="text-sm sm:text-base text-text-secondary font-medium">
            Portrayed by <strong class="text-white">{character.actor}</strong> · {character.movieIds.length} Core MCU Appearances
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Character Movie Timeline ── -->
  <section class="py-16">
    <CharacterTimeline client:load movieIds={character.movieIds} />
  </section>

  <!-- ── Cross-Links to Other Characters ── -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-white/[0.06]">
    <div class="text-center mb-10">
      <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-muted-dark block mb-1">
        MORE TITANS
      </span>
      <h3 class="font-display text-2xl text-white font-bold">
        Explore Other MCU Champions
      </h3>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {otherCharacters.map((c) => (
        <a
          href={`/character/${c.slug}`}
          class="group block p-4 rounded-2xl border border-white/[0.06] bg-[#0c0e18] hover:border-white/20 transition-all text-center space-y-2"
        >
          <div class="w-16 h-16 rounded-full overflow-hidden mx-auto border border-white/10 group-hover:scale-105 transition-transform">
            <img src={c.poster} alt={c.name} class="w-full h-full object-cover object-top" />
          </div>
          <h4 class="font-display text-sm font-bold text-white group-hover:text-text-secondary transition-colors">
            {c.name}
          </h4>
          <span class="text-[10px] font-mono text-muted-dark block">
            {c.tagline}
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>