---
import Layout from "../layouts/Layout.astro";
import CHARACTERS from "../data/characters.json";
import movies from "../data/movies.json";

const CHARACTER_THEMES = {
  "iron-man": { accent: "text-amber-400", border: "border-amber-500/30", glow: "hover:shadow-amber-500/20" },
  "captain-america": { accent: "text-blue-400", border: "border-blue-500/30", glow: "hover:shadow-blue-500/20" },
  "thor": { accent: "text-cyan-400", border: "border-cyan-500/30", glow: "hover:shadow-cyan-500/20" },
  "spider-man": { accent: "text-red-400", border: "border-red-500/30", glow: "hover:shadow-red-500/20" },
  "star-lord": { accent: "text-purple-400", border: "border-purple-500/30", glow: "hover:shadow-purple-500/20" },
};
---

<Layout
  title="MCU Character Roster — Road to Doomsday"
  description="Discover the heroes, villains, and icons shaping the road to Avengers: Doomsday. Explore their dedicated movie journeys and MCU arcs."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-crimson animate-pulse"></span>
        <span class="text-[11px] font-mono font-bold uppercase tracking-[0.25em] text-crimson-bright">MCU HALL OF LEGENDS</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-extrabold text-white tracking-wide title-glow">
        THE CHARACTER <span class="text-crimson-bright">ROSTER</span>
      </h1>
      <p class="text-sm sm:text-base text-muted leading-relaxed">
        Explore the heroes, villains, and supporting characters of the MCU, with their movie appearances and individual cinematic journeys.
      </p>
      <p class="text-xs font-mono text-muted-dark">{CHARACTERS.length} characters · character-specific artwork</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {CHARACTERS.map((char) => {
        const theme = CHARACTER_THEMES[char.slug] || { accent: "text-crimson-bright", border: "border-crimson/30", glow: "hover:shadow-crimson/20" };
        const appearances = (char.movieIds || []).map((id) => movies.find((m) => m.id === id)).filter(Boolean);
        const hasDirectImage = typeof char.poster === "string" && /^https:\/\//i.test(char.poster);
        const initials = char.name.split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase();

        return (
          <a href={`/character/${char.slug}`} class={`group block rounded-3xl overflow-hidden border border-white/[0.08] bg-[#0c0e18] transition-all duration-500 hover:border-white/25 hover:-translate-y-2 hover:shadow-2xl ${theme.glow}`}>
            <div class="relative aspect-[3/4] w-full overflow-hidden bg-[#101522]">
              <div data-image-placeholder class="absolute inset-0 flex items-center justify-center bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-700/40 via-[#101522] to-black">
                <div class="text-center px-4">
                  <div class="mx-auto mb-3 flex h-20 w-20 items-center justify-center rounded-full border border-white/15 bg-black/30 font-display text-3xl font-black text-white/60">{initials}</div>
                  <span class="block text-xs font-mono uppercase tracking-widest text-white/35">Loading character artwork</span>
                </div>
              </div>
              <img
                src={hasDirectImage ? char.poster : undefined}
                alt={`${char.name} — individual character artwork`}
                data-character-image
                data-character-name={char.imageLookupName || char.name}
                data-character-query={char.imageLookupQuery || `${char.name} Marvel character`}
                data-image-loaded={hasDirectImage ? "true" : "false"}
                class={`absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105 ${hasDirectImage ? "" : "hidden"}`}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0c0e18] via-transparent to-black/30 opacity-90"></div>
              <div class="absolute top-4 right-4 z-10">
                <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-black/70 backdrop-blur-md text-white border border-white/15">{char.tagline}</span>
              </div>
              <div class="absolute bottom-4 left-4 right-4 z-10">
                <span class={`text-[11px] font-mono uppercase tracking-widest font-semibold ${theme.accent}`}>{char.actor}</span>
                <h3 class="font-display text-2xl sm:text-3xl font-extrabold text-white group-hover:text-text-secondary transition-colors leading-tight">{char.name}</h3>
              </div>
            </div>

            <div class="p-6 space-y-4">
              <div class="space-y-1">
                <span class="text-[10px] font-mono uppercase tracking-wider text-muted-dark block">APPEARANCES ({appearances.length} TITLES):</span>
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {appearances.slice(0, 4).map((m) => <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/[0.04] text-muted-dark border border-white/[0.06]">{m.title}</span>)}
                  {appearances.length > 4 && <span class="px-2 py-0.5 text-[10px] font-mono text-muted-dark">+{appearances.length - 4} more</span>}
                </div>
              </div>
              <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono">
                <span class="text-muted group-hover:text-white transition-colors">View Full MCU Story Arc</span>
                <span class="text-crimson-bright font-bold">&rarr;</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>

<script>
  const API_BASE = "https://marvelcinematicuniverse.fandom.com/api.php";
  const cache = new Map();

  async function searchCharacterArtwork(query) {
    if (cache.has(query)) return cache.get(query);
    const task = (async () => {
      const url = new URL(API_BASE);
      url.searchParams.set("action", "query");
      url.searchParams.set("format", "json");
      url.searchParams.set("origin", "*");
      url.searchParams.set("generator", "search");
      url.searchParams.set("gsrsearch", query);
      url.searchParams.set("gsrnamespace", "0");
      url.searchParams.set("gsrlimit", "8");
      url.searchParams.set("prop", "pageimages");
      url.searchParams.set("piprop", "thumbnail");
      url.searchParams.set("pithumbsize", "700");

      const response = await fetch(url.toString(), { credentials: "omit" });
      if (!response.ok) throw new Error(`Character image search failed: ${response.status}`);
      const data = await response.json();
      const pages = Object.values(data?.query?.pages || {}).filter((page) => page?.thumbnail?.source && page?.title);
      const normalizedQuery = query.toLowerCase().replace(/[^a-z0-9 ]/g, " ").replace(/\s+/g, " ").trim();
      const tokens = normalizedQuery.split(" ").filter((token) => token.length > 2 && !["marvel", "cinematic", "universe", "character", "the", "earth", "variant"].includes(token));
      const ranked = pages.map((page) => {
        const title = page.title.toLowerCase().replace(/[^a-z0-9 ]/g, " ").replace(/\s+/g, " ").trim();
        const matched = tokens.filter((token) => title.includes(token)).length;
        const score = (title === normalizedQuery ? 100 : title.includes(normalizedQuery) ? 60 : 0) + matched * 5;
        return { page, score };
      }).filter((item) => item.score > 0).sort((a, b) => b.score - a.score);
      return ranked.map((item) => ({ url: item.page.thumbnail.source, title: item.page.title }));
    })();
    cache.set(query, task);
    return task;
  }

  async function resolveImage(img) {
    if (img.dataset.resolving === "true" || img.dataset.imageLoaded === "true") return;
    img.dataset.resolving = "true";
    const placeholder = img.parentElement?.querySelector("[data-image-placeholder]");
    const queries = [...new Set([img.dataset.characterQuery, img.dataset.characterName].filter(Boolean))];
    try {
      for (const query of queries) {
        const candidates = await searchCharacterArtwork(query);
        for (const candidate of candidates) {
          const loaded = await new Promise((resolve) => {
            const timeout = window.setTimeout(() => resolve(false), 8000);
            img.onload = () => { window.clearTimeout(timeout); resolve(true); };
            img.onerror = () => { window.clearTimeout(timeout); resolve(false); };
            img.src = candidate.url;
          });
          if (loaded) {
            img.dataset.imageLoaded = "true";
            img.dataset.imageSourceTitle = candidate.title;
            img.classList.remove("hidden");
            if (placeholder) placeholder.classList.add("hidden");
            return;
          }
        }
      }
    } catch (error) {
      console.warn("Could not load character-specific artwork:", img.dataset.characterName, error);
    } finally {
      img.dataset.resolving = "false";
    }
  }

  document.querySelectorAll("img[data-character-image]").forEach((img) => {
    img.addEventListener("error", () => {
      img.dataset.imageLoaded = "false";
      img.classList.add("hidden");
      const placeholder = img.parentElement?.querySelector("[data-image-placeholder]");
      if (placeholder) placeholder.classList.remove("hidden");
      resolveImage(img);
    });

    if (img.dataset.imageLoaded === "true") {
      const placeholder = img.parentElement?.querySelector("[data-image-placeholder]");
      if (placeholder) placeholder.classList.add("hidden");
    }
  });

  const imageObserver = "IntersectionObserver" in window ? new IntersectionObserver((entries, observer) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const img = entry.target;
      observer.unobserve(img);
      if (img.dataset.imageLoaded !== "true") resolveImage(img);
    }
  }, { rootMargin: "500px 0px" }) : null;

  document.querySelectorAll("img[data-character-image]").forEach((img) => {
    if (imageObserver) imageObserver.observe(img);
    else if (img.dataset.imageLoaded !== "true") resolveImage(img);
  });
</script>
