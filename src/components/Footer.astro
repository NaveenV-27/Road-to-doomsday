---
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/journey", label: "Journey" },
  { href: "/timeline", label: "Timeline" },
  { href: "/characters", label: "Characters" },
  { href: "/multiverse", label: "Multiverse" },
  { href: "/archive", label: "Archive" },
  { href: "/watchlist", label: "Watchlist" },
  { href: "/privacy-policy", label: "Privacy Policy" },
];
---

<footer class="w-full border-t border-white/[0.08] bg-[#050608] text-muted text-xs pt-16 pb-12 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-12 border-b border-white/[0.06]">
      <!-- Brand & Mission -->
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-crimson shadow-[0_0_8px_rgba(220,38,38,0.8)]"></span>
          <span class="font-display text-sm font-bold tracking-[0.2em] text-white uppercase">
            Road to <span class="text-crimson-bright">Doomsday</span>
          </span>
        </a>
        <p class="text-muted-dark leading-relaxed text-[13px] max-w-sm">
          A dedicated interactive cinematic companion for tracing the journey across the Marvel Cinematic Universe toward <span class="text-text-secondary">Avengers: Doomsday</span>.
        </p>
        <p class="text-[11px] text-muted-dark/80">
          Unofficial fan project. Not affiliated with, authorized, or endorsed by Marvel Studios, Disney, or their subsidiaries.
        </p>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="font-display text-[11px] font-bold uppercase tracking-[0.2em] text-text-secondary mb-4">
          Navigation
        </h4>
        <ul class="grid grid-cols-2 gap-2.5">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-muted hover:text-white transition-colors duration-200 text-[12px] uppercase tracking-wider font-medium"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact & Legal -->
      <div class="space-y-4">
        <h4 class="font-display text-[11px] font-bold uppercase tracking-[0.2em] text-text-secondary mb-4">
          Contact & Legal
        </h4>
        <div class="space-y-2.5">
          <a
            href="mailto:waytodoomsday@gmail.com"
            class="flex items-center gap-2.5 text-muted hover:text-white transition-colors text-[13px]"
          >
            <svg class="w-4 h-4 text-muted-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>waytodoomsday@gmail.com</span>
          </a>
          <a
            href="/privacy-policy"
            class="flex items-center gap-2.5 text-muted hover:text-white transition-colors text-[13px]"
          >
            <svg class="w-4 h-4 text-muted-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Privacy Policy</span>
          </a>
        </div>
        <p class="font-mono text-[11px] text-muted-dark/80 pt-2">
          "One timeline. Countless stories."
        </p>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-muted-dark font-mono">
      <span>&copy; {currentYear} Road to Doomsday. All original fan curation reserved.</span>
      <span>Marvel, Avengers, and related titles & logos &copy; Marvel &amp; Disney.</span>
    </div>
  </div>
</footer>
